{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "build",
    "rootDir": "src",
    "paths": {
      "@wavemaker-ai/app-rn-runtime/components/*": [
        "./node_modules/@wavemaker/app-rn-runtime/components/*",
        "./node_modules/@wavemaker/app-rn-runtime/components-prism/*"
      ],
      "@wavemaker-ai/app-rn-runtime/*": ["./node_modules/@wavemaker/app-rn-runtime/*"],
      "@wavemaker/rn-components/*": ["../components/build/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "build", "dist", "test"]
}
